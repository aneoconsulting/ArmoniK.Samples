{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    "group:allNonMajor",
    ":semanticCommitTypeAll(chore)",
    "helpers:pinGitHubActionDigests",
    "docker:pinDigests"
  ],
  "semanticCommits": "enabled",
  "rangeStrategy": "bump",
  "prBodyTemplate": "# Motivation\n\nAutomated dependency update by Renovate bot.\n\n# Description\n\n{{{table}}}{{{notes}}}\n\n# Testing\n\nThis is an automated dependency update. No functional changes are expected.\n\n# Impact\n\n{{{changelogs}}}\n\n# Additional Information\n\n{{{warnings}}}{{{errors}}}{{{controls}}}This PR was generated automatically by [Renovate](https://docs.renovatebot.com/).",
  "packageRules": [
    {
      "groupName": "nuget packages",
      "groupSlug": "nuget",
      "excludePackagePrefixes": [
        "Armonik.DevelopmentKit",
        "ArmoniK.Api"
      ],
      "matchDatasources": [
        "nuget"
      ]
    },
    {
      "groupName": "Armonik.DevelopmentKit",
      "groupSlug": "nuget-armonik-development-kit",
      "matchPackagePrefixes": [
        "Armonik.DevelopmentKit"
      ],
      "matchDatasources": [
        "nuget"
      ]
    },
    {
      "groupName": "ArmoniK.Api",
      "groupSlug": "nuget-armonik-api",
      "matchPackagePrefixes": [
        "ArmoniK.Api"
      ],
      "matchDatasources": [
        "nuget"
      ]
    },
    {
      "groupName": "ArmoniK Java packages",
      "groupSlug": "maven-armonik",
      "matchPackagePrefixes": [
        "fr.aneo:armonik"
      ],
      "matchDatasources": [
        "maven"
      ]
    },
    {
      "groupName": "docker images",
      "groupSlug": "docker",
      "matchDatasources": [
        "docker"
      ]
    },
    {
      "description": "Keep .NET images on the 10 LTS line",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "mcr.microsoft.com/dotnet/**"
      ],
      "allowedVersions": "<11"
    },
    {
      "groupName": "github actions",
      "groupSlug": "github-actions",
      "matchDatasources": [
        "github-tags"
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions passed to actions, annotated with a '# renovate:' comment",
      "managerFilePatterns": [
        "/^\\.github/(actions|workflows)/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[\\w-]+: (?<currentValue>\\S+)"
      ]
    }
  ]
}
