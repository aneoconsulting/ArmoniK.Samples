{
  "Serilog":  {
    "Using":  [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel":  "Information",
    "WriteTo":  [
      {
        "Name":  "Console",
        "Args":  {
          "standardErrorFromLevel":  "Verbose"
        }
      }
    ]
  },
  "Grpc":  {
    "EndPoint":  "http://localhost:5001"
  },
  "Partition":  "quantlib",
  "BatchSize":  10
}
