<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ArmoniK.Extensions.CSharp.Client" Version="0.23.0" />
    <!-- ArmoniK.Extensions.CSharp.Client 0.23.0 is compiled against 10.0.13 but does not bring it on net10.0 -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
